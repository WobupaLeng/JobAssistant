# ============================================================
# AI 求职助手 —— 仓库忽略规则
#
# 原则：只提交「源码 + 构建脚本 + 文档」，
#       依赖、构建产物、本地数据（含登录 cookie）一律不入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn/

# ---------- 构建产物 ----------
# 前端构建输出（trunk / vite build 生成；tauri build 会重新生成）
frontend-vue/dist/
dist/
# Rust 编译产物（单次全量构建 3.9 GB+）
target/
backend-tauri/target/
backend-tauri/gen/schemas/
# Tauri CLI 依赖（构建走 npx tauri，不能删但也不入库）
frontend-vue/node_modules/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.xml
htmlcov/

# ---------- 本地运行数据（严禁入库）----------
# 只忽略仓库根的 data/（SQLite 数据库含 Boss 登录 cookie + 241 MB Chrome profile）。
# 必须带前导 `/`：不带的 `data/` 会匹配任意层级的 data 目录，
# 曾把 frontend-vue/src/lib_ui/data/cities.ts（373 城源码数据）一起吞掉、静默漏提交。
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
browser-profile/

# ---------- 日志 ----------
*.log
# 只忽略仓库根的运行时日志目录。必须带前导 `/`：
# 不带的 `logs/` 会匹配任意层级的 logs 目录，把 frontend-vue/src/features/logs/（源码）一起吞掉。
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
!.vscode/extensions.json
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/

# ---------- 调试残留 / 工具缓存 ----------
.dsh-acl-recovery/
.diag-page.png
*.tsbuildinfo
nohup.out

# 测试临时目录（Low IL 下 %LOCALAPPDATA%\Temp 不可写，门禁把 TEMP 指到这里）
.tmp-test/
# 诊断取证产物（repro lane 的 runs/ logs/ 抓取快照，含本机路径与进程信息）
.tmp-diag/
.tmp-diag2/
