{
  "name": "jobassistant-webview",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "AI 求职助手 WebView 界面（Vue 3 + Vite + TypeScript）。只经 window.__TAURI_INTERNALS__.invoke 与 Rust 通信。",
  "scripts": {
    "dev": "vite --port 8080 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 8080 --strictPort",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
